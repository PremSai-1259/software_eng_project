# Groq is attempted first. OpenAI is used automatically if Groq fails.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini

# OpenAI is the chat fallback and can also power embeddings.
OPENAI_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Local persistence paths
APP_DATA_DIR=data
VECTOR_DB_PATH=data/chroma

# Version 2 runs beside the original app without port conflicts.
APP_PORT=8001
